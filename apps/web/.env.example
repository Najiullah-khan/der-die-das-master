# --- Site ---
# Absolute origin used for canonical URLs, sitemap entries, structured data, and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database ---
# Leave both unset for local dev: falls back to a local file (./local.db) via libSQL,
# zero cloud setup required. Fill these in once you provision a real Turso database:
#   turso auth login
#   turso db create der-die-das-master
#   turso db show der-die-das-master --url
#   turso db tokens create der-die-das-master
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Auth (Better Auth) ---
# Generate a random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth providers — optional. Sign-in buttons just won't work until these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Magic-link email — optional. Falls back to logging the link to the server console.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Admin (/admin blog CRUD) ---
# Only the signed-in user whose email matches this exactly gets admin access; everyone else gets 403.
ADMIN_EMAIL=

# --- Gamification ---
# Shared secret for POST /api/cron/refresh-leaderboard (blueprint §14). In production, point a
# Cloudflare Cron Trigger at that route with this as a Bearer token. Locally, run `pnpm refresh-leaderboard`
# instead — it calls the same logic directly, no HTTP/secret needed.
CRON_SECRET=

# --- Error monitoring (blueprint §10/§16) ---
# Optional. Format: https://<publicKey>@<host>/<projectId> — from a Sentry project's Client Keys
# (DSN) settings. Server-side errors (Server Components, Route Handlers, Server Actions) are
# reported via instrumentation.ts when this is set; unset, they just log to the console.
SENTRY_DSN=
